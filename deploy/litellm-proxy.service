[Unit]
Description=LiteLLM Proxy (Production)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/kraken-chatbot
EnvironmentFile=/home/ubuntu/kraken-chatbot/deploy/litellm.env
ExecStart=/home/ubuntu/.local/bin/litellm --config deploy/litellm.config.yaml --host 127.0.0.1 --port 4000
Restart=always
RestartSec=5
SyslogIdentifier=litellm-proxy

[Install]
WantedBy=multi-user.target
